# Copy to .env (or set in your shell). All values below are the defaults.
# 127.0.0.1, not localhost: on Windows + Docker Desktop, "localhost" adds ~45 ms to
# every search request (measured with scripts/es_latency_probe.py).
ES_URL=http://127.0.0.1:9200
DATA_DIR=data/processed
INDEX_DIR=indexes
RUNS_DIR=runs
# Where ir_datasets caches raw downloads (MS MARCO is ~1 GB compressed)
IR_DATASETS_HOME=data/raw/ir_datasets
